* text=auto

# Windows araç zinciri (VS, MSBuild) CRLF bekliyor
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.slnx      text eol=crlf
*.json      text eol=crlf
*.md        text eol=crlf

# Unix tarafında çalışanlar
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# İkili dosyalar — asla dönüştürülmez
*.png       binary
*.jpg       binary
*.mp4       binary
*.wav       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
*.woff2     binary

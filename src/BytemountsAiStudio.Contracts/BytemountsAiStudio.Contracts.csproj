<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Dagitik hiz siniri ve devre kesici (P4-03). -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BytemountsAiStudio.Core\BytemountsAiStudio.Core.csproj" />
  </ItemGroup>

  <!--
    Istem dosyalari derlemeye GOMULUYOR (P1-07).

    Neden: aksi halde her cagiran taraf `prompts/` dizinini bulmak
    zorunda kalirdi ve calisma dizini degistigi anda kirilirdi - testler,
    CI, yayinlanmis tek dosyalik arac, hepsi ayri ayri. Gomulu kopya
    dosyalarin AYNISI oldugu icin iki kaynak arasinda kayma olusamiyor.

    Diskteki dizin verildiginde o kazaniyor: istem duzenleyip yeniden
    derlemeden denemek mumkun kalsin.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\prompts\**\v*.md" LinkBase="Embedded" />
  </ItemGroup>

  <!--
    BOS GLOB DERLEMEYI DUSURUYOR (P4-05).

    Yasandi: Docker imaji `prompts/` dizinini derleme baglamina hic
    kopyalamiyordu. Glob hicbir dosya bulamadi, MSBuild TEK BIR UYARI
    BILE vermedi, imaj basariyla derlendi ve saglikli basladi; ama
    hicbir video uretemedi. Hata ancak ilk run'da, `prompts.empty`
    olarak, uretim ortaminda gorundu.

    Bos bir glob "istem yok" demek degil, "bir sey yanlis" demek:
    bu depoda istemsiz bir derlemenin gecerli bir kullanimi yok.
  -->
  <Target Name="IstemlerGomuluMu" AfterTargets="AssignTargetPaths">
    <Error Condition="'@(EmbeddedResource)' == ''"
           Text="Hic istem dosyasi gomulmedi. `prompts/` dizini derleme baglaminda mi? (Docker: `COPY prompts/`)" />
  </Target>

</Project>
